# Copy to ./.env at the repo root and fill in before `docker compose up`.

# Public address Caddy serves. A real domain auto-gets HTTPS (after you remove the
# `tls internal` line in deploy/Caddyfile); 'localhost' uses a self-signed cert.
SITE_ADDRESS=localhost

# Basic Auth — the ONLY thing between the internet and your trading account (the app
# itself has no per-user login). Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-strong-password'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# App secret — MUST be overridden from the insecure code default.
APP_SECRET_KEY=

# Postgres password (defaults to 'trading' if unset).
POSTGRES_PASSWORD=trading

# IB Gateway runs on the HOST (a GUI app — cannot be containerized). The defaults reach
# the host from inside the container. The Gateway must be running, logged into the paper
# account, with the API enabled on this port.
IBKR_HOST=host.docker.internal
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# Options data (Triple Calendar etc.) — your Polygon key.
POLYGON_API_KEY=
