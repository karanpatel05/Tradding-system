# Copy to .env and fill in. The app boots even with everything below unset
# (SQLite + "OAuth not configured" auth panel state).

# --- App ---
ENVIRONMENT=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local default (no infra). docker-compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./trading.db
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

# --- Tastytrade OAuth ---
# The OAuth client/provider secret for your Tastytrade OAuth application.
# OPTIONAL: if left blank, the secret can be entered in the front-page auth panel
# alongside the refresh token. Set it here to preconfigure it server-side instead.
# The *refresh token* is always entered in the UI, never here.
TASTYTRADE_PROVIDER_SECRET=
# Use the certification (sandbox) environment:
TASTYTRADE_IS_TEST=false

# --- Engine ---
MAX_STRATEGIES=5
SCAN_INTERVAL_SECONDS=60

# --- LIVE ORDER ROUTING (real money) ---
# Master safety switch. Default false: strategies run fully (signals, sizing,
# trade records) but orders are logged as [PAPER] and NOT transmitted.
# Set true to transmit REAL orders to Tastytrade. STRONGLY recommended to first
# run against the certification env by also setting TASTYTRADE_IS_TEST=true above.
ENABLE_LIVE_ORDERS=false

# --- EMA scalper (strategy_1) — all optional, sensible defaults shown ---
# Signal (5-min candles)
EMA_FAST=9
EMA_SLOW=15
EMA_ATR_LENGTH=14
EMA_CANDLE_INTERVAL=5m
EMA_SLOPE_LOOKBACK=3
EMA_SLOPE_MIN=0.10
EMA_ENTRY_EXPIRY_BARS=3
EMA_RISK_REWARD=2.0
EMA_RISK_PCT=0.01
EMA_ATR_STOP_CAP=1.5
EMA_SLIPPAGE_PCT=0.0005
# Scanner (daily watchlist)
EMA_WATCHLIST_SIZE=10
EMA_TREND_EMA_LENGTH=50
EMA_MIN_ATR_PCT=0.02
EMA_MIN_REL_VOLUME=1.2
EMA_MIN_AVG_VOLUME=1000000
EMA_MIN_PRICE=5.0
# Regime filter + session window (US/Eastern)
EMA_REGIME_FILTER=true
EMA_REGIME_SYMBOL=SPY
EMA_SESSION_START_ET=09:35
EMA_SESSION_CUTOFF_ET=15:45
